{
  "name": "taiwan-smart-life-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "build:styles": "tailwindcss -c tailwind.mobile.config.cjs -i src/mobile-tailwind.css -o www/mobile-tailwind.css --minify",
    "build:runtime": "esbuild src/mobile-runtime.js --bundle --minify --format=iife --platform=browser --outfile=www/mobile-runtime.js",
    "assets": "node scripts/generate-brand-assets.mjs && capacitor-assets generate --android",
    "prepare:native": "npm run sync:web && npm run build:styles && npm run build:runtime && npm run assets && cap sync android",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-debug.ps1",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "esbuild": "0.25.12",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=22"
  }
}
